{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Svyable/scrollq/main/evals/dataset.schema.json",
  "title": "ScrolIQ held-out evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "task",
    "held_out",
    "truth_commitment_sha256",
    "regions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["ink_detection", "geometry", "segmentation"]},
    "held_out": {"const": true},
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "truth_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scroll_id", "volume_root"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scroll_id": {"type": "string", "minLength": 1},
          "volume_root": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svyable.github.io/scrollq/schemas/eval-region-results-v1.json",
  "title": "ScrolIQ per-region task adapter results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "dataset", "task", "regions"],
  "properties": {
    "schema_version": {"const": 1},
    "model": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "task": {"enum": ["ink", "geometry", "segmentation"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_sha256",
        "inference_script_sha256",
        "inference_config_sha256"
      ],
      "properties": {
        "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inference_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inference_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "description": "Verified inference-run identity. Optional for schema migration, but scroliq-eval requires exact matches for rank eligibility."
    },
    "regions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "metrics"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"const": "ok"},
              "metrics": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "additionalProperties": {"type": "number"}
              },
              "evidence_sha256": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "description": "Optional content hashes for region-specific evidence such as prediction/truth surfaces or frozen task specifications."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "reason"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"const": "failed"},
              "reason": {"type": "string", "minLength": 1},
              "metrics": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "additionalProperties": {"type": "number"},
                "description": "Optional diagnostics retained even when the region fails; never used to rescue the failure value."
              },
              "evidence_sha256": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        ]
      }
    }
  }
}
